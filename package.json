{
  "name": "your-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI paper research agent with LangGraph runtime + RAG memory + paper-code alignment",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "cd apps/gateway && npm run dev",
    "dev:runtime": "cd apps/runtime && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "lerna run build",
    "test": "lerna run test"
  },
  "devDependencies": {
    "lerna": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.2.62",
    "@langchain/ollama": "^0.1.6",
    "katex": "^0.17.0",
    "langchain": "^0.3.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
